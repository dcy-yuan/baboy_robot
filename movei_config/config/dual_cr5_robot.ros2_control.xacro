<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
    <xacro:macro name="dual_cr5_robot_ros2_control" params="name initial_positions_file">
        <xacro:property name="initial_positions" value="${load_yaml(initial_positions_file)['initial_positions']}"/>

        <ros2_control name="${name}" type="system">
            <hardware>
                <!-- By default, set up controllers for simulation. This won't work on real hardware -->
                <plugin>mock_components/GenericSystem</plugin>
            </hardware>
            <joint name="left_jt1">
                <command_interface name="position"/>
                <state_interface name="position">
                  <param name="initial_value">${initial_positions['left_jt1']}</param>
                </state_interface>
                <state_interface name="velocity"/>
            </joint>
            <joint name="left_jt2">
                <command_interface name="position"/>
                <state_interface name="position">
                  <param name="initial_value">${initial_positions['left_jt2']}</param>
                </state_interface>
                <state_interface name="velocity"/>
            </joint>
            <joint name="left_jt3">
                <command_interface name="position"/>
                <state_interface name="position">
                  <param name="initial_value">${initial_positions['left_jt3']}</param>
                </state_interface>
                <state_interface name="velocity"/>
            </joint>
            <joint name="left_jt4">
                <command_interface name="position"/>
                <state_interface name="position">
                  <param name="initial_value">${initial_positions['left_jt4']}</param>
                </state_interface>
                <state_interface name="velocity"/>
            </joint>
            <joint name="left_jt5">
                <command_interface name="position"/>
                <state_interface name="position">
                  <param name="initial_value">${initial_positions['left_jt5']}</param>
                </state_interface>
                <state_interface name="velocity"/>
            </joint>
            <joint name="left_jt6">
                <command_interface name="position"/>
                <state_interface name="position">
                  <param name="initial_value">${initial_positions['left_jt6']}</param>
                </state_interface>
                <state_interface name="velocity"/>
            </joint>
            <joint name="right_jt1">
                <command_interface name="position"/>
                <state_interface name="position">
                  <param name="initial_value">${initial_positions['right_jt1']}</param>
                </state_interface>
                <state_interface name="velocity"/>
            </joint>
            <joint name="right_jt2">
                <command_interface name="position"/>
                <state_interface name="position">
                  <param name="initial_value">${initial_positions['right_jt2']}</param>
                </state_interface>
                <state_interface name="velocity"/>
            </joint>
            <joint name="right_jt3">
                <command_interface name="position"/>
                <state_interface name="position">
                  <param name="initial_value">${initial_positions['right_jt3']}</param>
                </state_interface>
                <state_interface name="velocity"/>
            </joint>
            <joint name="right_jt4">
                <command_interface name="position"/>
                <state_interface name="position">
                  <param name="initial_value">${initial_positions['right_jt4']}</param>
                </state_interface>
                <state_interface name="velocity"/>
            </joint>
            <joint name="right_jt5">
                <command_interface name="position"/>
                <state_interface name="position">
                  <param name="initial_value">${initial_positions['right_jt5']}</param>
                </state_interface>
                <state_interface name="velocity"/>
            </joint>
            <joint name="right_jt6">
                <command_interface name="position"/>
                <state_interface name="position">
                  <param name="initial_value">${initial_positions['right_jt6']}</param>
                </state_interface>
                <state_interface name="velocity"/>
            </joint>

        </ros2_control>
    </xacro:macro>
</robot>
