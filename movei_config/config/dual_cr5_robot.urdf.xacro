<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="dual_cr5_robot">
    <xacro:arg name="initial_positions_file" default="initial_positions.yaml" />

    <!-- Import dual_cr5_robot urdf file -->
    <xacro:include filename="$(find cr5)/urdf/dual_arm.xacro" />

    <!-- Import control_xacro -->
    <xacro:include filename="dual_cr5_robot.ros2_control.xacro" />


    <xacro:dual_cr5_robot_ros2_control name="FakeSystem" initial_positions_file="$(arg initial_positions_file)"/>

</robot>
